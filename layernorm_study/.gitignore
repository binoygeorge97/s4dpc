__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.msgpack
checkpoints/
wandb/
.venv/

# per CLAUDE.md's "CSV is ground truth" convention, output is gitignored,
# directory structure (.gitkeep) is not. results/ itself needs no rule here -
# the repo ROOT .gitignore already has a bare `results/`, which (unlike a
# rule scoped with a leading slash) matches a directory of that name at any
# depth, catching layernorm_study/results/ too - confirmed directly: adding
# a `!results/.gitkeep` override here did NOT work, because git's directory-
# exclusion short-circuit means it never descends into an already-excluded
# directory to check a deeper .gitignore's negation at all. figures/ has no
# such parent-level rule, so it needs (and gets) its own here.
figures/*
!figures/.gitkeep
