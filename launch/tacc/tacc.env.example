# Local, user-specific TACC config. Copy this file to `tacc.env` (gitignored,
# never committed) and fill in real values:
#
#   cp launch/tacc/tacc.env.example launch/tacc/tacc.env
#
# Every launch/tacc/*.sh script that talks to TACC sources tacc.env. No
# secrets belong here — this is host/path/partition config only. TACC
# authentication (password + 6-digit MFA) is always typed interactively at
# the ssh/rsync prompt; nothing in this file or any script automates it.

TACC_USER=binoygeorge
TACC_HOST=ls6.tacc.utexas.edu
TACC_ALLOCATION=IRI26016

# Persistent repo checkout on TACC (under $WORK - survives $SCRATCH purges).
TACC_REPO_DIR=/work/11460/binoygeorge/ls6/s4dpc

# Durable CSV/log/checkpoint output root on TACC (under $WORK).
TACC_RESULTS_DIR=/work/11460/binoygeorge/ls6/s4dpc-results

# Python venv on TACC (under $SCRATCH - rebuildable, not paper-critical).
TACC_VENV_DIR=/scratch/11460/binoygeorge/venvs/s4dpc

# Queues (CLAUDE.md: never auto-escalate to gpu-a100 or gpu-h100).
TACC_SMOKE_PARTITION=gpu-a100-dev
TACC_PROD_PARTITION=gpu-a100-small

# Git branch/ref that sync_tacc.sh keeps TACC's checkout on (fetch +
# checkout + fast-forward-only). Defaults to main; set to a feature branch
# (e.g. infra/tacc) to validate it on real TACC hardware before merging.
TACC_GIT_REF=main
