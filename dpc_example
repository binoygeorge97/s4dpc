# ============================================================
# Differentiable Predictive Control THROUGH A LEARNED MODEL
#
# Pipeline for ONE chosen system:
#   1. Identify the plant with a linear NN:  x_{k+1} = W x + V u   (W~A, V~B)
#   2. Train the GRU controller by unrolling through the LEARNED model (A_hat,B_hat)
#   3. Test the controller on the TRUE plant (A,B) -- the honest transfer test
#
# Kaggle: plots render inline via plt.show().
# If flax.nnx / optax are missing:  !pip install -q -U flax optax
# ============================================================
import numpy as np
import jax
import jax.numpy as jnp
from flax import nnx
import optax
from scipy.signal import cont2discrete
import matplotlib.pyplot as plt
 
dt = 0.02
 
# ============================================================
#                     >>> CHOOSE HERE <<<
# ============================================================
# Pick any subset of systems (1..7). Examples:
#   CASES = [3]            -> just one
#   CASES = [1, 3, 6]      -> a few
#   CASES = list(range(1, 8))  -> all of them
CASES = [1, 2, 3, 4, 5, 6, 7]
COMPARE_WITH_TRUE = True    # also train a controller through the TRUE model as a reference
HIDDEN_DIM = 64
CTRL_LR = 1e-3
 
# LQR weights (same meaning as your DPC script)
config = {'N': 200, 'Q_x': 5.0, 'R_u': 0.1, 'Q_f': 50.0}
 
# Curriculum: grow the unroll horizon gradually (tames BPTT through unstable dynamics)
curriculum_phases = [
    {'N': 5,   'epochs': 1000},
    {'N': 10,   'epochs': 2000},
    {'N': 20,  'epochs': 2000},
    {'N': 50,  'epochs': 1000},
    {'N': 100, 'epochs': 1000},
    {'N': 200, 'epochs': 2000},
]
 
 
# ============================================================
# System generator (from the DPC script)
# ============================================================
def get_discrete_system(case):
    Z = np.zeros((2, 2))
    B_i = np.array([[0.0], [1.0]])
    Bc = np.block([[B_i, np.zeros((2,1)), np.zeros((2,1))],
                   [np.zeros((2,1)), B_i, np.zeros((2,1))],
                   [np.zeros((2,1)), np.zeros((2,1)), B_i]])
    tbl = {
        1: ("Case 1: Base (stable, coupled)",
            np.block([[np.array([[-3.5,-2.4],[0.,0.]]), np.array([[0.,.03],[0.,0.]]), np.array([[0.,.06],[0.,0.]])],
                      [Z, np.array([[-3.5,-2.3],[0.,0.]]), Z],[Z, Z, np.array([[-5.2,-5.3],[0.,0.]])]])),
        2: ("Case 2: Unstable uncoupled",
            np.block([[np.array([[1.,.5],[0.,2.]]), Z, Z],[Z, np.array([[1.5,.5],[0.,3.]]), Z],[Z, Z, np.array([[.5,.5],[0.,4.]])]])),
        3: ("Case 3: Oscillatory unstable",
            np.block([[np.array([[1.,2.],[-2.,1.]]), Z, Z],[Z, np.array([[2.,5.],[-5.,2.]]), Z],[Z, Z, np.array([[1.5,10.],[-10.,1.5]])]])),
        4: ("Case 4: Non-normal Jordan block",
            np.block([[np.array([[1.,100.],[0.,1.]]), Z, Z],[Z, np.array([[1.5,80.],[0.,1.5]]), Z],[Z, Z, np.array([[2.,120.],[0.,2.]])]])),
        5: ("Case 5: Weakly coupled unstable",
            np.block([[np.array([[1.,1.],[0.,2.]]), np.array([[.3,-.2],[0.,.4]]), np.array([[.1,0.],[0.,-.3]])],
                      [Z, np.array([[1.5,.7],[0.,3.]]), np.array([[.25,-.15],[0.,.2]])],[Z, Z, np.array([[.5,1.2],[0.,4.]])]])),
        6: ("Case 6: Ill-conditioned eigenvectors",
            np.block([[np.array([[1.,1000.],[.001,1.]]), Z, Z],[Z, np.array([[1.5,800.],[.002,1.5]]), Z],[Z, Z, np.array([[2.,1200.],[.0015,2.]])]])),
        7: ("Case 7: Mixed stable/unstable",
            np.block([[np.array([[-2.,.5],[0.,.5]]), Z, Z],[Z, np.array([[-1.,.5],[0.,1.5]]), Z],[Z, Z, np.array([[-3.,.5],[0.,2.]])]])),
    }
    name, Ac = tbl[case]
    sd, idim = Ac.shape[0], Bc.shape[1]
    sysd = cont2discrete((Ac, Bc, np.eye(sd), np.zeros((sd, idim))), dt, method='zoh')
    return np.array(sysd[0]), np.array(sysd[1]), name
 
 
# ============================================================
# STEP 1: learned linear dynamics model  x_{k+1} = W x + V u
# ============================================================
from flax import nnx
 
class LinearDynamicsModel(nnx.Module):
    def __init__(self, state_dim, input_dim, *, rngs: nnx.Rngs):
        # 1. Simple linear layers in front of the LayerNorms
        self.pre_linear_x = nnx.Linear(state_dim, state_dim, rngs=rngs)
        self.pre_linear_u = nnx.Linear(input_dim, input_dim, rngs=rngs)
        
        # 2. LayerNorms to be placed before W and V
        self.norm_x = nnx.LayerNorm(state_dim, rngs=rngs)
        self.norm_u = nnx.LayerNorm(input_dim, rngs=rngs)
        
        # 3. Original W and V layers
        self.W = nnx.Linear(state_dim, state_dim, use_bias=False, rngs=rngs)
        self.V = nnx.Linear(input_dim, state_dim, use_bias=False, rngs=rngs)
 
    def __call__(self, x, u):
        # Pass inputs through the pre-linear layer and then LayerNorm
        x_processed = self.norm_x(self.pre_linear_x(x))
        u_processed = self.norm_u(self.pre_linear_u(u))
        
        # Apply W and V to the processed, normalized inputs
        out = self.W(x_processed) + self.V(u_processed)
        return out
 
 
def make_dataset(A, B, key, n, x_range=3.0, u_range=3.0):
    sd, idim = A.shape[0], B.shape[1]
    kx, ku = jax.random.split(key)
    X = jax.random.uniform(kx, (n, sd), minval=-x_range, maxval=x_range)
    U = jax.random.uniform(ku, (n, idim), minval=-u_range, maxval=u_range)
    Xn = X @ A.T + U @ B.T
    return X, U, Xn
 
 
def train_linear_model(A, B, key, name="", epochs=200, batch_size=1024,
                       n=40000, lr=5e-3, verbose=True):
    sd, idim = A.shape[0], B.shape[1]
    kd, km = jax.random.split(key)
    X, U, Xn = make_dataset(A, B, kd, n)
 
    xu = jnp.concatenate([X, U], 1)
    in_mu, in_sd = xu.mean(0), xu.std(0) + 1e-8
    out_mu, out_sd = Xn.mean(0), Xn.std(0) + 1e-8
    Xw = (X - in_mu[:sd]) / in_sd[:sd]
    Uw = (U - in_mu[sd:]) / in_sd[sd:]
    Yw = (Xn - out_mu) / out_sd
 
    model = LinearDynamicsModel(sd, idim, rngs=nnx.Rngs(km))
    
    # Note: LayerNorm already contains learnable bias/scale parameters, 
    # so we don't need a separate model.bias parameter manually added to the class anymore.
    opt = nnx.Optimizer(model, optax.adamw(lr, weight_decay=0.0), wrt=nnx.Param)
 
    @nnx.jit
    def step(m, o, xb, ub, yb):
        def loss_fn(mm):
            # Using the __call__ method ensures LayerNorm is applied
            pred = mm(xb, ub)
            return jnp.mean((pred - yb) ** 2)
        loss, grads = nnx.value_and_grad(loss_fn)(m)
        o.update(m, grads)
        return loss
 
    @nnx.jit
    def phys_mse(m):
        # Using the __call__ method here as well
        pred = m(Xw, Uw) * out_sd + out_mu
        return jnp.mean((pred - Xn) ** 2)
 
    steps_per_epoch = max(1, n // batch_size)
    if verbose:
        print(f"\n=== STEP 1: identifying {name} ===")
    for epoch in range(epochs):
        perm = np.array(jax.random.permutation(jax.random.PRNGKey(epoch), n))
        for i in range(steps_per_epoch):
            idx = perm[i * batch_size:(i + 1) * batch_size]
            step(model, opt, Xw[idx], Uw[idx], Yw[idx])
        if verbose and (epoch % 5 == 0 or epoch == epochs - 1):
            print(f"  epoch {epoch+1:3d}/{epochs} | MSE (physical units): {float(phys_mse(model)):.6e}")
 
    # WARNING: Because LayerNorm is a non-linear operation, extracting just the weights
    # W and V here to form A_hat and B_hat will not yield a mathematically equivalent 
    # linear system. The controller will only see these extracted linear approximations.
    Wk = np.array(model.W.kernel.value); Vk = np.array(model.V.kernel.value)
    isd = np.array(in_sd); osd = np.array(out_sd)
    A_hat = (osd[None, :] * (Wk / isd[:sd, None])).T
    B_hat = (osd[None, :] * (Vk / isd[sd:, None])).T
    return A_hat, B_hat
 
 
# ============================================================
# STEP 2: GRU controller + DPC loss (from your DPC script)
# ============================================================
class StandaloneGRUController(nnx.Module):
    def __init__(self, d_x, hidden_dim, d_u, max_action, rngs: nnx.Rngs):
        self.hidden_dim = hidden_dim
        self.max_action = max_action
        self.W_z = nnx.Linear(d_x + hidden_dim, hidden_dim, rngs=rngs)
        self.W_r = nnx.Linear(d_x + hidden_dim, hidden_dim, rngs=rngs)
        self.W_h = nnx.Linear(d_x + hidden_dim, hidden_dim, rngs=rngs)
        self.head = nnx.Linear(hidden_dim, d_u, rngs=rngs)
 
    def __call__(self, h_prev, x_curr):
        hx = jnp.concatenate([x_curr, h_prev], axis=-1)
        z = jax.nn.sigmoid(self.W_z(hx))
        r = jax.nn.sigmoid(self.W_r(hx))
        rhx = jnp.concatenate([x_curr, r * h_prev], axis=-1)
        h_tilde = jax.nn.tanh(self.W_h(rhx))
        h_new = (1 - z) * h_prev + z * h_tilde
        u_total = self.head(h_new)              # unbounded (matches your working setup)
        return h_new, u_total
 
 
def compute_lqr_loss(model, x0, A, B, config, horizon_N):
    """Rolls the controller through the dynamics (A,B) -- these may be TRUE or LEARNED."""
    x = x0
    batch_size = x.shape[0]
    h = jnp.zeros((batch_size, model.hidden_dim))
    trajectory_loss = 0.0
    for k in range(horizon_N):
        h, u_k = model(h, x)
        x_next = jnp.matmul(x, A.T) + jnp.matmul(u_k, B.T)
        state_cost = jnp.sum((x ** 2) * config['Q_x'], axis=-1)
        effort_cost = jnp.sum((u_k ** 2) * config['R_u'], axis=-1)
        trajectory_loss += jnp.mean(state_cost + effort_cost)
        x = x_next
    terminal_cost = jnp.mean(jnp.sum((x ** 2) * config['Q_f'], axis=-1))
    return (trajectory_loss + terminal_cost) / horizon_N
 
 
def train_controller(A_train, B_train, key, label=""):
    """Train a GRU controller by unrolling through (A_train, B_train)."""
    A_train = jnp.array(A_train); B_train = jnp.array(B_train)
    state_dim, input_dim = A_train.shape[0], B_train.shape[1]
 
    controller = StandaloneGRUController(state_dim, HIDDEN_DIM, input_dim,
                                         max_action=100.0, rngs=nnx.Rngs(0))
    optimizer = nnx.Optimizer(controller, optax.adamw(CTRL_LR), wrt=nnx.Param)
    x0_batch = jax.random.uniform(key, shape=(1000, state_dim), minval=-3.0, maxval=3.0)
 
    def make_step(N):
        @nnx.jit
        def train_step(mdl, opt, x0):
            def loss_fn(m):
                return compute_lqr_loss(m, x0, A_train, B_train, config, N)
            loss, grads = nnx.value_and_grad(loss_fn)(mdl)
            opt.update(mdl, grads)
            return loss
        return train_step
 
    print(f"\n=== STEP 2: training GRU controller through the {label} model ===")
    for pi, phase in enumerate(curriculum_phases):
        N, epochs = phase['N'], phase['epochs']
        stepfn = make_step(N)
        print(f"  -- phase {pi+1}: horizon {N} --")
        for epoch in range(epochs):
            loss = stepfn(controller, optimizer, x0_batch)
            if epoch % max(1, epochs // 4) == 0 or epoch == epochs - 1:
                print(f"     epoch {epoch:4d} | LQR cost (on {label} model): {float(loss):.4f}")
    return controller
 
 
# ============================================================
# STEP 3: evaluate a controller on the TRUE plant
# ============================================================
def rollout_true(controller, A_true, B_true, x0, horizon):
    A = jnp.array(A_true); B = jnp.array(B_true)
    h = jnp.zeros((x0.shape[0], controller.hidden_dim))
    x = x0
    xs = [x]; us = []
    for k in range(horizon):
        h, u = controller(h, x)
        x = jnp.matmul(x, A.T) + jnp.matmul(u, B.T)
        us.append(u); xs.append(x)
    return np.array(jnp.stack(xs)), np.array(jnp.stack(us))   # (H+1,B,sd), (H,B,du)
 
 
def true_lqr_cost(x_hist, u_hist, config):
    stage = np.sum(x_hist[:-1] ** 2, axis=-1) * config['Q_x'] + \
            np.sum(u_hist ** 2, axis=-1) * config['R_u']
    term = np.sum(x_hist[-1] ** 2, axis=-1) * config['Q_f']
    return float((stage.sum(axis=0) + term).mean() / x_hist.shape[0])
 
 
# ============================================================
# Plots (inline for Kaggle)
# ============================================================
def plot_closed_loop(x_hist, u_hist, title):
    H = u_hist.shape[0]
    t_x = np.arange(H + 1) * dt
    t_u = np.arange(H) * dt
    sd = x_hist.shape[2]; du = u_hist.shape[2]; nsc = x_hist.shape[1]
 
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 8), sharex=True)
    for i in range(nsc):
        for j in range(sd):
            ax1.plot(t_x, x_hist[:, i, j], alpha=0.6, label=f"state {j+1}" if i == 0 else "")
        for j in range(du):
            ax2.step(t_u, u_hist[:, i, j], where='post', alpha=0.6,
                     label=f"action {j+1}" if i == 0 else "")
    ax1.axhline(0, color='black', ls='--', lw=1.5)
    ax1.set_ylabel("system states"); ax1.set_title(title); ax1.grid(True, alpha=0.3)
    ax2.axhline(0, color='black', ls='--', lw=1.5)
    ax2.set_ylabel("control u"); ax2.set_xlabel("time (s)"); ax2.grid(True, alpha=0.3)
    fig.tight_layout(); plt.show()
 
 
def plot_norm_comparison(hists, labels, title):
    """||x(t)|| convergence on the TRUE plant for one or more controllers."""
    fig, ax = plt.subplots(figsize=(11, 5))
    for x_hist, lab in zip(hists, labels):
        H = x_hist.shape[0] - 1
        t = np.arange(H + 1) * dt
        norm = np.linalg.norm(x_hist, axis=2).mean(axis=1)   # mean over scenarios
        ax.semilogy(t, norm + 1e-12, lw=2, label=lab)
    ax.set_ylabel("mean state norm  ||x||  (log)")
    ax.set_xlabel("time (s)"); ax.set_title(title)
    ax.grid(True, which="both", alpha=0.3); ax.legend()
    fig.tight_layout(); plt.show()
 
 
# ============================================================
# One full pipeline for a single system
# ============================================================
def run_case(case):
    A_true, B_true, name = get_discrete_system(case)
    print(f"\n########## {name} ##########")
 
    # --- Step 1: identify the plant ---
    A_hat, B_hat = train_linear_model(A_true, B_true, jax.random.PRNGKey(0), name=name)
    a_err = np.linalg.norm(A_hat - A_true) / np.linalg.norm(A_true)
    b_err = np.linalg.norm(B_hat - B_true) / np.linalg.norm(B_true)
    print(f"  identified model: A_err {a_err:.2e} | B_err {b_err:.2e}")
 
    # --- Step 2: train controller through the LEARNED model ---
    ctrl_learned = train_controller(A_hat, B_hat, jax.random.PRNGKey(1), label="LEARNED")
 
    # --- Step 3: test on the TRUE plant ---
    eval_key = jax.random.PRNGKey(123)
    x0_eval = jax.random.uniform(eval_key, shape=(3, A_true.shape[0]), minval=-5.0, maxval=5.0)
 
    x_hist_L, u_hist_L = rollout_true(ctrl_learned, A_true, B_true, x0_eval, config['N'])
    cost_L = true_lqr_cost(x_hist_L, u_hist_L, config)
    print(f"\n>>> Controller trained on LEARNED model -> TRUE-plant LQR cost: {cost_L:.4f}")
    plot_closed_loop(x_hist_L, u_hist_L,
                     f"{name}\ncontroller trained through LEARNED model, tested on TRUE plant")
 
    # --- Optional reference: controller trained through the TRUE model ---
    cost_T = None
    if COMPARE_WITH_TRUE:
        ctrl_true = train_controller(A_true, B_true, jax.random.PRNGKey(1), label="TRUE")
        x_hist_T, u_hist_T = rollout_true(ctrl_true, A_true, B_true, x0_eval, config['N'])
        cost_T = true_lqr_cost(x_hist_T, u_hist_T, config)
        print(f"\n>>> Controller trained on TRUE   model -> TRUE-plant LQR cost: {cost_T:.4f}")
        print(f">>> Cost gap from using the learned model: {cost_L - cost_T:+.4f} "
              f"({100*(cost_L-cost_T)/max(abs(cost_T),1e-9):+.1f}%)")
        plot_norm_comparison([x_hist_L, x_hist_T],
                             ["trained on learned model", "trained on true model"],
                             f"{name} -- closed-loop regulation on the TRUE plant")
 
    return {'case': case, 'name': name, 'A_err': a_err, 'B_err': b_err,
            'cost_learned': cost_L, 'cost_true': cost_T}
 
 
# ============================================================
# RUN the chosen systems
# ============================================================
results = []
for case in CASES:
    results.append(run_case(case))
 
# ---- summary across all chosen systems ----
print("\n\n================= SUMMARY =================")
hdr = f"{'system':40s} | {'A_err':>9s} | {'cost (learned)':>14s}"
if COMPARE_WITH_TRUE:
    hdr += f" | {'cost (true)':>11s} | {'gap %':>7s}"
print(hdr)
print("-" * len(hdr))
for r in results:
    line = f"{r['name']:40s} | {r['A_err']:9.2e} | {r['cost_learned']:14.4f}"
    if COMPARE_WITH_TRUE and r['cost_true'] is not None:
        gap = 100 * (r['cost_learned'] - r['cost_true']) / max(abs(r['cost_true']), 1e-9)
        line += f" | {r['cost_true']:11.4f} | {gap:+7.1f}"
    print(line)