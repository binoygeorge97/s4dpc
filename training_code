def example_train_regression(dataset: str, layer: str, seed: int, model_cfg: dict, train_cfg: dict):
    print("[*] Setting Randomness...")
    torch.manual_seed(seed)
    key = jax.random.PRNGKey(seed)
    key, model_rng, train_rng = jax.random.split(key, 3)
 
    create_dataset_fn = Datasets[dataset]
    trainloader, testloader, d_input, d_output = create_dataset_fn(
        bsz=train_cfg['bsz'], L=model_cfg.get('l_max', 100),
        system_case=config.get('system_case', 1), dt=config['dt']
    )
 
    print(f"[*] Starting Regression Training on `{dataset}`")
 
    # 2. Initialize Model
    rngs = nnx.Rngs(params=model_rng, dropout=0)
 
    stacked_args = model_cfg.copy()
    s4_N = stacked_args.pop('N')
    l_max = stacked_args.pop('l_max')
    if 'embedding' in stacked_args:
        stacked_args.pop('embedding')
 
    model = StackedModelRegression(
        layer_cls=S4LayerEnsemble,
        layer_args={'N': s4_N, 'l_max': l_max},
        d_input=d_input,
        d_output=d_output,
        decode=False,
        rngs=rngs,
        **stacked_args
    )
 
    # 3. Initialize Optimizer
    optimizer = create_optimizer(
        model,
        base_lr=train_cfg['lr'],
        weight_decay=train_cfg['weight_decay'],
        total_steps=len(trainloader) * train_cfg['epochs']
    )
 
    # 4. Training Loop
    best_loss = 1e9
 
    for epoch in range(train_cfg['epochs']):
        train_rng, train_loss = train_epoch(train_rng, model, optimizer, trainloader)
        test_loss = validate(model, testloader)
 
        print(f"Epoch {epoch+1} | Train MSE: {train_loss:.6f} | Test MSE: {test_loss:.6f}")
 
        if test_loss < best_loss:
            best_loss = test_loss
            import os
            os.makedirs(f"checkpoints/{dataset}", exist_ok=True)
            save_path = f"checkpoints/{dataset}/{layer}_best_model.msgpack"
 
            full_config = {
                'dataset': dataset, 'layer': layer,
                'model': model_cfg, 'train': train_cfg
            }
            save_model(model, full_config, save_path)
            print(f"    🌟 New Best MSE: {best_loss:.6f}")
 
    return model
 
 
from flax import serialization
 
def save_model(model, config, filename="s4_model.msgpack"):
    # 1. Extract the parameters
    # FIX: Convert the NNX State object to a standard Python dictionary
    model_state = nnx.state(model, nnx.Param).to_pure_dict()
    
    # 2. Bundle with config
    checkpoint_data = {
        'model_state': model_state,
        'config': config
    }
    
    # 3. Serialize to bytes
    byte_data = serialization.to_bytes(checkpoint_data)
    
    # 4. Write to file
    with open(filename, 'wb') as f:
        f.write(byte_data)
    
    print(f"✅ Model saved to {filename}")
 
 
